OZON_CLIENT_ID=
OZON_API_KEY=
FLASK_SECRET_KEY=

# PDF-этикетки (необязательно; по умолчанию DejaVu из системы)
# LABEL_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# LABEL_BRAND_LINE=STIGMA
# LABEL_SELLER=ИП Главацкая С.П.
# LABEL_COMPOSITION=100% Хлопок
# LABEL_COUNTRY=Россия
# Эталон Ozon из кабинета (файл в корне репо). Не заменять страницей из lenta_zakazov — координаты в label_pdf.py привязаны к оригиналу.
# Для WB отдельно: scripts/extract_label_template.py → instance/wb_label_template.pdf
# LABEL_TEMPLATE_PDF=/srv/stigma_fbs/print_2026_03_25_21_41.pdf
# LABEL_TEMPLATE_PAGE=0
# LABEL_WIDTH_MM=204.6111   # 580 pt — ширина этикетки как в шаблоне PDF
# LABEL_HEIGHT_MM=141.1111  # 400 pt — высота

# Только для git push с сервера (не нужен самому приложению)
GITHUB_TOKEN=

# Wildberries: полная синхронизация каталога (sync_wb_catalog.py / flask sync-wb-catalog)
# WB_CATALOG_SYNC_USE_LOCK=0   # отключить lock-файл (не рекомендуется при cron)
# WB_CATALOG_SYNC_LOCK_PATH=/srv/stigma_fbs/instance/wb_catalog_sync.lock
# WB_SYNC_BUILD_LABEL_PDF=0    # не генерировать ШК при синхронизации (только при скачивании)

# SQLite при параллельной синхронизации и UI (секунды / миллисекунды ожидания блокировки)
# SQLITE_CONNECT_TIMEOUT_SEC=120
# SQLITE_BUSY_TIMEOUT_MS=120000
